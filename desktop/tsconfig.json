{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@pocketinput/shared": [
        "../shared/src/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "../shared/src/**/*"
  ]
}
